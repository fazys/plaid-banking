# Plaid keys. These can also be entered in the dashboard (Settings → Plaid),
# which takes priority and keeps a separate secret for sandbox and production.
PLAID_CLIENT_ID=
# PLAID_SECRET is the secret for the PLAID_ENV below.
PLAID_SECRET=
# Optional: per-environment secrets, so you can switch in Settings.
# PLAID_SECRET_SANDBOX=
# PLAID_SECRET_PRODUCTION=

# Supported values: sandbox | production
# Plaid retired the Development environment in June 2024.
# Use sandbox with Sandbox keys, or production to connect real bank accounts.
PLAID_ENV=production

# The admin (master) login for the React dashboard. Change these before deploying.
# The admin sees everything, including Settings, and can add users there.
# Users can only sign in and connect banks (stored in DATA_DIR/users.json).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional instead of ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# true behind HTTPS. Leave unset to follow the incoming request (req.secure).
# COOKIE_SECURE=true

HOST=0.0.0.0
PORT=3000
DATA_DIR=./data

# Existing Google Sheet. Paste the full URL or just the spreadsheet ID.
# Tabs are created automatically as "Sept 2026", "Oct 2026", and so on.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional. Put every month on one tab with this name instead of one tab per month.
# The current month is on top; older months move down.
# GOOGLE_SHEETS_SINGLE_TAB=All Banks
# Optional. Also write bookkeeping tabs: one statement tab per account, a Cash Burn
# Report tab per month and a Cash Summary tab (see README).
# BOOKKEEPING_ENABLED=true
# Reports page in the dashboard (admin only): shows the Google Sheet's tabs.
# true = show it, false = hide it. Restart the app after changing this.
REPORTS_ENABLED=true
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# Optional. Save month-end PDFs into this Drive folder (share it with the service account).
# GOOGLE_PDF_FOLDER_ID=
# Optional. Share each month PDF with this Google account.
# GOOGLE_PDF_SHARE_EMAIL=

TZ=America/New_York
DAILY_SYNC_ENABLED=true
DAILY_SYNC_CRON=59 11 * * *
# Optional. Required if you call POST /api/daily_sync from the public internet.
# DAILY_SYNC_SECRET=

# Optional. Needed for some OAuth institutions such as Chase.
# Register this exact URI in the Plaid Dashboard under Allowed redirect URIs.
# PLAID_REDIRECT_URI=http://localhost:3000
# On DigitalOcean, use your public HTTPS URL, for example:
# PLAID_REDIRECT_URI=https://banks.example.com/
